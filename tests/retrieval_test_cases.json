  {
    "id": "SEM_HORMONAL_REF",
    "suite": "semantic_clinical_queries",
    "query": "résultat hormonal avec valeur de référence",
    "query_type": "semantic",
    "expected_conditions": {
      "all": [
        { "metadata_not_empty": "reference_range" }
      ],
      "any": [
        { "text_contains_any": ["TSH", "TSHus", "T3", "T4", "ACTH", "INSULINE", "PEPTIDE C", "CALCITONINE"] },
        { "metadata_text_contains_any": { "field": "section", "values": ["immunoanalyse", "résultats biologiques"] } }
      ]
    }
  },
  {
    "id": "SEM_PARASITO_POSITIVE",
    "suite": "semantic_clinical_queries",
    "query": "résultat parasitologie positif",
    "query_type": "semantic",
    "expected_conditions": {
      "all": [
        { "metadata_equals": { "field": "document_type", "value": "parasitology_stool_report" } }
      ],
      "any": [
        { "chunk_type_in": ["clinical_result"] },
        { "text_contains_any": ["parasite", "pathogène", "pathogene", "trichuris", "ankylostoma", "oeufs", "kyste"] }
      ]
    }
  },
  {
    "id": "SEM_ABOVE_REF",
    "suite": "semantic_clinical_queries",
    "query": "résultat avec valeur supérieure à la référence",
    "query_type": "semantic",
    "expected_conditions": {
      "any": [
        { "metadata_equals": { "field": "interpretation_status", "value": "above_reference" } },
        { "text_contains_any": ["above_reference", "supérieure à la référence", "au dessus de la référence"] }
      ]
    }
  },
