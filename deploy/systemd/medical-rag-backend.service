[Unit]
Description=Medical RAG backend API
After=network-online.target ollama.service
Wants=network-online.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/medical-rag-platform
EnvironmentFile=/opt/medical-rag-platform/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/medical-rag-platform/venv/bin/uvicorn backend_api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
