{
  "name": "medical-rag-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Clinical RAG Assistant frontend and backend workspace",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "clean:next": "rm -rf .next .next-dev .next-build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ci:nonregression:reference-range": "bash scripts/ci/non_regression_reference_range.sh",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/e2e/theme-visual.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=desktop-chromium --workers=1 --timeout=180000"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.9",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "idb": "^8.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.0.4",
    "next-themes": "^0.4.4",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
